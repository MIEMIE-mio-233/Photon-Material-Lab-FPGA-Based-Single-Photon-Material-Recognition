# vitis_hls -f run.tcl, or vitis-run --mode hls --tcl run.tcl
# Run on the isolated workspace generated by prepare.py.
set here [file dirname [file normalize [info script]]]
set ::env(TDC_TEST_DATA_DIR) [file join $here fixtures]
foreach variant {shared separate} {
    cd [file join $here $variant]
    open_project -reset project
    set_top tdc_accelerator
    add_files [file join $here $variant kernel.cpp]
    add_files -tb [file join $here fixtures check_rtl.cpp]
    open_solution -reset solution1 -flow_target vivado
    set_part {xczu4ev-sfvc784-1-i}
    create_clock -period 10 -name default
    config_interface -m_axi_addr64
    csim_design
    csynth_design
    close_project
}
exit
